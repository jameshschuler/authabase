{
    "name": "@authabase/react",
    "type": "module",
    "version": "0.2.0",
    "description": "Reusable React auth components with Supabase integration, shadcn UI, and configurable auth methods",
    "main": "dist/index.cjs",
    "types": "dist/index.d.ts",
    "module": "dist/index.esm.js",
    "style": "dist/styles.css",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": {
            "import": "./dist/index.esm.js",
            "require": "./dist/index.cjs",
            "default": "./dist/index.esm.js",
            "types": "./dist/index.d.ts"
        },
        "./components": {
            "import": "./dist/components/index.js",
            "default": "./dist/components/index.js",
            "types": "./dist/components/index.d.ts"
        },
        "./provider": {
            "import": "./dist/provider/index.js",
            "default": "./dist/provider/index.js",
            "types": "./dist/provider/index.d.ts"
        },
        "./types": {
            "import": "./dist/types/index.js",
            "default": "./dist/types/index.js",
            "types": "./dist/types/index.d.ts"
        },
        "./styles.css": {
            "default": "./dist/styles.css"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "dev": "vite",
        "build": "node -e \"require('fs').rmSync('dist',{ recursive: true, force: true })\" && tsc -p tsconfig.build.json && vite build",
        "build:watch": "vite build --watch",
        "preview": "vite preview",
        "lint": "eslint src --ext .ts,.tsx",
        "lint:fix": "eslint src --ext .ts,.tsx --fix",
        "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
        "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
        "test": "vitest",
        "test:run": "vitest --run",
        "test:ui": "vitest --ui",
        "test:coverage": "vitest --coverage",
        "type-check": "tsc --noEmit",
        "storybook": "storybook dev -p 6006",
        "build-storybook": "storybook build",
        "release:whoami": "npm whoami",
        "release:contents-check": "node -e \"const cp=require('child_process'); const out=cp.execSync('npm pack --dry-run --json',{encoding:'utf8'}); const data=JSON.parse(out); const files=(data[0]?.files||[]).map(f=>f.path); const bad=files.filter(p=>/(^|\\/)dist\\/(tests|stories)\\/|\\.test\\.|\\.stories\\./.test(p)); if(bad.length){console.error('Disallowed files in package:\\n'+bad.join('\\n')); process.exit(1)} console.log('Package contents check passed')\"",
        "release:check": "npm run release:whoami && npm run type-check && npm run test:run && npm run build && npm run release:contents-check",
        "release:dry-run": "npm run release:check && npm pack --dry-run",
        "release:publish": "npm run release:check && npm publish --access public"
    },
    "dependencies": {
        "@base-ui/react": "^1.0.0",
        "@supabase/supabase-js": "^2.39.0",
        "class-variance-authority": "^0.7.0",
        "clsx": "^2.0.0",
        "input-otp": "^1.4.2",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.0",
        "@storybook/react": "^10.3.6",
        "@storybook/react-vite": "^10.3.6",
        "@tailwindcss/postcss": "^4.2.4",
        "@tailwindcss/vite": "^4.2.4",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.1.5",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.5.1",
        "@types/node": "^25.0.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@typescript-eslint/eslint-plugin": "^8.0.0",
        "@typescript-eslint/parser": "^8.0.0",
        "@vitejs/plugin-react": "^6.0.0",
        "@vitest/ui": "^4.1.0",
        "autoprefixer": "^10.4.16",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.0.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.0",
        "jsdom": "^29.0.0",
        "postcss": "^8.4.32",
        "prettier": "^3.1.1",
        "storybook": "^10.3.6",
        "tailwindcss": "^4.2.0",
        "typescript": "^6.0.0",
        "typescript-eslint": "^8.59.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.0"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "tailwindcss": "^4.0.0"
    },
    "keywords": [
        "react",
        "auth",
        "authentication",
        "supabase",
        "components",
        "typescript"
    ],
    "author": "James Schuler",
    "license": "ISC",
    "repository": {
        "type": "git",
        "url": "https://github.com/jameshschuler/authabase"
    }
}